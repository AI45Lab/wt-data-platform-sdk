# Copy this file to .env in the integrating service. Do not commit the real .env.
# Load it before starting Python, for example:
#   set -a && source .env && set +a && python your_service.py

# DLDB / storage connection (2026.10 storage split: landing hot layer on GPFS,
# serving delivery layer on S3). Both are optional — unset they fall back to
# the built-in defaults below. Legacy WT_SDK_DB_URI is no longer read.
# WT_SDK_LANDING_DB_URI=/mnt/shared-storage-user/adpc-share/wt-data-platform/landing
# WT_SDK_SERVING_DB_URI=s3://wt-data-platform
# Optional: required only by ETL checkpoint initialization/incremental ETL.
# Ordinary WT SDK clients and manual targeted ETL do not read this setting.
# WT_SDK_ETL_STATE_DB_URI=s3://wind-tunnel-etl
# Separate database used by EnvConfigManager (GPFS since the storage split).
# Optional like the roles above — unset it falls back to the built-in default
# below. WT_SDK_PROFILE selects env_test or wt_env_config inside this database.
# WT_SDK_ENV_CONFIG_DB_URI=/mnt/shared-storage-user/adpc-share/wt-data-platform/env-config
WT_SDK_S3_ENDPOINT=http://your-s3-endpoint:8060
WT_SDK_S3_ALLOW_HTTP=true
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
AWS_EC2_METADATA_DISABLED=true

# Table env selection. Optional values: production or test.
WT_SDK_PROFILE=test

# FreeCoT extraction service (decodes encrypted reasoning content).
# Base URL ending with /v1/ — the stage appends extract-claude-cot or extract-gpt-cot.
# ORIGIN_COT_SERVICE_URL=http://your-extractor-host:8080/v1/
# Wrapper key — sent as x-api-key (Claude) or Authorization: Bearer (GPT).
# ORIGIN_COT_WRAPPER_KEY=replace-with-your-wrapper-key
# Upstream Boyue API key — passed as api_key in the request body.
# Required for GPT extraction; optional for Claude.
# NEW_API_KEY=replace-with-your-boyue-api-key

# Optional DLDB timing / metrics settings.
# WT_SDK_DLDB_MODEL=metrics
# WT_SDK_LOG_DLDB_TIMING=1
# WT_SDK_DLDB_METRICS_LOG=./wt_metrics_log.jsonl
